# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma CLI and the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amtul_noor?schema=public"

# For local development only, `npm run db:local start` starts a PostgreSQL from
# node_modules and prints a connection string like this one.
# DATABASE_URL="postgresql://postgres:postgres@localhost:54329/amtul_noor_library?sslmode=disable"

# Secret used to sign the admin session cookie (any long random string).
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin login for the library management app.
ADMIN_EMAIL="admin@amtulnoorlibrary.com"
# bcrypt hash of the admin password. Generate a ready to paste line with:
#   npm run hash-password -- "your-password"
#
# WARNING: Next.js expands $VAR inside .env values, so every $ in a bcrypt hash
# must be written as \$. A plain hash is silently emptied and login always fails.
# npm run hash-password prints the line with the backslashes already added.
ADMIN_PASSWORD_HASH=""

# Only used by `npm run smoke`, never by the app. The login test asks you for the
# password if this is missing, so you only need it for unattended runs.
# TEST_ADMIN_PASSWORD="your-password"

# The site's own domain, e.g. "https://amtulnoorlibrary.com". Used to build the
# absolute URLs behind search-engine metadata, the sitemap and social shares.
# When unset, the address of the incoming request is used instead, which is
# correct on Vercel and in local development.
# NEXT_PUBLIC_SITE_URL="https://amtulnoorlibrary.com"

# ---------------------------------------------------------------------------
# Outgoing email (optional).
#
# Receipts can always be downloaded as a PDF and sent on WhatsApp. To also email
# receipts, application decisions and support threads, create a free Resend
# account (https://resend.com), verify the sending domain, and paste the API key
# below. With the key set, the app sends receipts (as a PDF attachment),
# application approval/rejection notices and support messages. Without it the
# app says email is not set up yet, and everything else keeps working.
# ---------------------------------------------------------------------------
# RESEND_API_KEY="re_..."
# The sender shown on all outgoing email. Must be on a domain verified in Resend.
# Defaults to Resend's test sender when unset.
# RESEND_FROM="Amtul Noor Library <support@amtulnoorlibrary.com>"