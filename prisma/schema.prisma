// Amtul Noor Library - database schema
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum MemberStatus {
  ACTIVE
  LEFT
}

enum PaymentMode {
  CASH
  ONLINE
  OFFER
}

enum PaymentStatus {
  PAID
  PENDING
  WAIVED
  NOT_APPLICABLE
  ON_HOLD
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The two abilities a role can grant. The owner picks a role's name freely,
/// so several day-to-day names can exist, but only these two levels do.
enum RoleLevel {
  /// Full access: the day-to-day library work, plus user accounts and the
  /// monthly fee / settings.
  ADMIN
  /// Day-to-day work only: members, applications, payments, reminders and seats.
  /// Cannot open the Users screen or change the monthly fee.
  DAY_TO_DAY
}

/// The areas a role can be granted. Stored as a list on each role; a full-admin
/// role is always treated as having every one, so it cannot lock itself out.
enum Permission {
  MEMBERS
  APPLICATIONS
  PAYMENTS
  REMINDERS
  SEATS
  REPORTS
  SETTINGS
  USERS
}

/// What someone did and when, for the owner's peace of mind. Sign-ins, sign-outs
/// and access changes are written here so the Users screen can show a running
/// history of who has been in the app.
enum ActivityAction {
  LOGIN
  LOGOUT
  ROLE_CHANGED
  DEACTIVATED
  REACTIVATED
  PASSWORD_CHANGED
  PASSWORD_VIEWED
}

/// A physical room in the library (Room 1, Room 2, ...).
model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  seats     Seat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single study desk. Seats are never deleted implicitly; a seat keeps its
/// identity so historic member -> seat links stay meaningful.
model Seat {
  id           Int           @id @default(autoincrement())
  roomId       Int
  seatNumber   String
  status       SeatStatus    @default(AVAILABLE)
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  occupants    Member[]
  /// Applications that asked for this seat. A request, not a reservation:
  /// the seat stays free until the owner approves and it is assigned.
  applications Application[] @relation("ApplicationPreferredSeat")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([roomId, seatNumber])
  @@index([status])
}

/// Permanent personal record of a person who joined the library.
/// Rows are never deleted; a person who leaves is kept with status LEFT.
model Member {
  id             Int           @id @default(autoincrement())
  memberId       String        @unique
  name           String
  mobile         String?
  /// Optional. Used to email fee receipts; not every member has one yet.
  email          String?
  guardianName   String?
  guardianMobile String?
  joiningDate    DateTime
  /// Current seat. Cleared when the member is marked Left.
  seatId         Int?
  status         MemberStatus  @default(ACTIVE)
  leavingDate    DateTime?
  remarks        String?
  /// A secret, unguessable token that gives this member a permanent, reusable
  /// link (/pay/<token>) for paying their fee and downloading their receipts.
  payToken       String?       @unique
  seat           Seat?         @relation(fields: [seatId], references: [id], onDelete: SetNull)
  payments       Payment[]
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([name])
  @@index([mobile])
  @@index([status])
  @@index([seatId])
}

/// One financial transaction for one member for one month.
/// A member can have many rows; nothing is ever overwritten.
model Payment {
  id           Int           @id @default(autoincrement())
  paymentId    String        @unique
  memberId     Int
  /// Calendar month in `YYYY-MM` form.
  month        String
  amount       Decimal       @db.Decimal(10, 2)
  paymentMode  PaymentMode
  paymentDate  DateTime
  status       PaymentStatus @default(PAID)
  remarks      String?
  /// A secret, unguessable token that lets a member download their own
  /// receipt without logging in (see the public /receipts/<token> route).
  receiptToken String?       @unique
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([month])
  @@index([status])
  @@index([memberId, month])
}

/// Small key/value store for the handful of library-wide settings we need.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A membership application submitted from the public join page. Nothing here
/// makes the person a member; the owner approves it and the member is created
/// from the details, so the same fields are never typed twice.
model Application {
  id                 Int               @id @default(autoincrement())
  name               String
  mobile             String
  email              String?
  address            String?
  /// The father / guardian, and their number, exactly as the applicant wrote
  /// them on the form.
  guardianName       String?
  guardianMobile     String?
  /// Aadhaar number as entered. Kept as text so leading zeroes are not lost.
  aadhaarNumber      String
  /// Where the scanned sides ended up (a local path in dev, a Blob URL on
  /// Vercel). Null when the applicant did not attach a side.
  aadhaarFrontUrl    String?
  aadhaarBackUrl     String?
  /// The exam or stream from the form's fixed options.
  preparingFor       String
  /// Filled when `preparingFor` was "Other".
  otherPreparation   String?
  /// The day the applicant hopes to join, from the "Date of joining" field.
  desiredJoiningDate DateTime
  /// The seat the applicant chose (a room + seat, from the seats that were
  /// free at the time). The public form requires it, so new applications
  /// always carry one; nullable so applications made before this existed, and
  /// rows whose seat was later removed, stay valid.
  preferredSeatId    Int?
  preferredSeat      Seat?             @relation("ApplicationPreferredSeat", fields: [preferredSeatId], references: [id], onDelete: SetNull)
  /// The "I have read and understood the rules" checkbox.
  agreed             Boolean           @default(false)
  /// Client address, kept so repeated spam from one source is visible.
  ip                 String            @default("")
  status             ApplicationStatus @default(PENDING)
  notes              String?
  /// The owner's explanation, set when the application is rejected and only
  /// when they chose to write one. Shown on the card and sent in the email.
  rejectionReason    String?
  /// Set when an application is approved; points at the member it created.
  memberId           Int?
  member             Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([mobile, createdAt])
  @@index([ip, createdAt])
  @@index([preferredSeatId])
}

/// One row per rejected sign-in attempt. Lives in the database because serverless
/// instances do not share memory, so an in-process counter would reset constantly.
/// Rows are pruned once they fall outside the window being measured.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  /// Lower-cased email that was submitted, so failures are counted per account.
  email     String
  /// Client address taken from x-forwarded-for / x-real-ip. Empty when unknown.
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// A named set of abilities the owner hands to people. The owner chooses each
/// role's name, so "Front desk" and "Reader" can both be day-to-day while
/// "Owner" is a full admin.
model Role {
  id        Int       @id @default(autoincrement())
  /// What the owner called it, shown on the Users screen and in the sidebar.
  name      String    @unique
  level     RoleLevel
  /// The areas this role can open and work in. A full-admin role ignores this
  /// list and is always granted everything, so it can never lock itself out.
  permissions Permission[]
  /// The seeded full-admin role. It can be renamed but not deleted, and its
  /// level cannot be lowered, so the library can never lock itself out.
  builtIn   Boolean   @default(false)
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([level])
}

/// Someone who can sign in to the app. Passwords are bcrypt hashes, never plain
/// text. Accounts are deactivated rather than deleted so the audit trail of
/// who worked here stays intact.
model User {
  id           Int       @id @default(autoincrement())
  /// The address they type on the login form. Unique across the app.
  email        String    @unique
  /// Display name, shown in the sidebar. Optional: the login form has no name.
  name         String?
  passwordHash String
  /// The last password the owner handed out for this account, kept encrypted
  /// so the owner can read it back when they forget what they gave someone.
  /// The bcrypt hash above stays the real credential; this copy is only
  /// readable by the app, with the key held in the environment.
  passwordCiphertext String?
  /// The named role this person signs in with. Every account has one.
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// A deactivated account cannot sign in, but its row is kept.
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  activity     ActivityLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roleId])
  @@index([active])
}

/// One entry in the who-did-what-when history. Written on sign-in and sign-out
/// and when access changes, so the Users screen can show recent activity. The
/// account is kept by reference so the list survives a rename, and rows are
/// never edited.
model ActivityLog {
  id        Int            @id @default(autoincrement())
  userId    Int?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Copy of the email at the time, so the entry still reads well if the
  /// account is later renamed or its row removed.
  email     String
  action    ActivityAction
  /// A short human-readable detail, e.g. the role someone moved to.
  detail    String         @default("")
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A message sent from the public help & support page. Anyone can write in
/// without an account, so this is deliberately separate from a membership
/// application: it is a question, a bug report or a note for the owner rather
/// than a request for a seat. Kept on record so nothing is lost if the
/// notification email bounces, and so repeated spam from one address shows up.
model SupportMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  /// The topic the visitor chose, from the fixed list on the form.
  topic     String
  message   String
  /// Client address, kept so repeated spam from one source is visible.
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}
