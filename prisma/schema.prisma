// Amtul Noor Library - database schema
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
}

enum MemberStatus {
  ACTIVE
  LEFT
}

enum PaymentMode {
  CASH
  ONLINE
  OFFER
}

enum PaymentStatus {
  PAID
  PENDING
  WAIVED
  NOT_APPLICABLE
  ON_HOLD
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A physical room in the library (Room 1, Room 2, ...).
model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  seats     Seat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single study desk. Seats are never deleted implicitly; a seat keeps its
/// identity so historic member -> seat links stay meaningful.
model Seat {
  id         Int        @id @default(autoincrement())
  roomId     Int
  seatNumber String
  status     SeatStatus @default(AVAILABLE)
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  occupants  Member[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([roomId, seatNumber])
  @@index([status])
}

/// Permanent personal record of a person who joined the library.
/// Rows are never deleted; a person who leaves is kept with status LEFT.
model Member {
  id             Int          @id @default(autoincrement())
  memberId       String       @unique
  name           String
  mobile         String?
  /// Optional. Used to email fee receipts; not every member has one yet.
  email          String?
  guardianName   String?
  guardianMobile String?
  joiningDate    DateTime
  /// Current seat. Cleared when the member is marked Left.
  seatId         Int?
  status         MemberStatus @default(ACTIVE)
  leavingDate    DateTime?
  remarks        String?
  seat           Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)
  payments       Payment[]
  applications   Application[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([name])
  @@index([mobile])
  @@index([status])
  @@index([seatId])
}

/// One financial transaction for one member for one month.
/// A member can have many rows; nothing is ever overwritten.
model Payment {
  id          Int           @id @default(autoincrement())
  paymentId   String        @unique
  memberId    Int
  /// Calendar month in `YYYY-MM` form.
  month       String
  amount      Decimal       @db.Decimal(10, 2)
  paymentMode PaymentMode
  paymentDate DateTime
  status      PaymentStatus @default(PAID)
  remarks     String?
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([month])
  @@index([status])
  @@index([memberId, month])
}

/// Small key/value store for the handful of library-wide settings we need.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A membership application submitted from the public join page. Nothing here
/// makes the person a member; the owner approves it and the member is created
/// from the details, so the same fields are never typed twice.
model Application {
  id        Int               @id @default(autoincrement())
  name      String
  mobile    String
  email     String?
  address   String?
  /// The father / guardian, and their number, exactly as the applicant wrote
  /// them on the form.
  guardianName   String?
  guardianMobile String?
  /// Aadhaar number as entered. Kept as text so leading zeroes are not lost.
  aadhaarNumber String
  /// Where the scanned sides ended up (a local path in dev, a Blob URL on
  /// Vercel). Null when the applicant did not attach a side.
  aadhaarFrontUrl  String?
  aadhaarBackUrl   String?
  /// The exam or stream from the form's fixed options.
  preparingFor     String
  /// Filled when `preparingFor` was "Other".
  otherPreparation String?
  /// The day the applicant hopes to join, from the "Date of joining" field.
  desiredJoiningDate DateTime
  /// The "I have read and understood the rules" checkbox.
  agreed    Boolean @default(false)
  /// Client address, kept so repeated spam from one source is visible.
  ip        String  @default("")
  status    ApplicationStatus @default(PENDING)
  notes     String?
  /// Set when an application is approved; points at the member it created.
  memberId  Int?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([mobile, createdAt])
  @@index([ip, createdAt])
}

/// One row per rejected sign-in attempt. Lives in the database because serverless
/// instances do not share memory, so an in-process counter would reset constantly.
/// Rows are pruned once they fall outside the window being measured.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  /// Lower-cased email that was submitted, so failures are counted per account.
  email     String
  /// Client address taken from x-forwarded-for / x-real-ip. Empty when unknown.
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
