# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template is committed, the real .env never is
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local development database
.local-db/

# dev script logs
.dev.log
.db.log
.dev-server.log
.local-db-start.log
.local-db.log
.local-db-err.log
.dev-server-err.log
# the same logs written without the leading dot, e.g. `npm run dev > dev.log`
dev.log
db.log
db-local.log
dev.err.log
prod.log

# Aadhaar scans saved while running against the local database. Vercel Blob
# stores them in production instead, so this folder is only a dev fallback.
/public/uploads/

# agent tooling installed by `npx prisma init` (regenerated on demand)
.agents/
.claude/
.windsurf/
skills-lock.json
