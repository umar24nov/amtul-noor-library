# Normalise line endings so the repo behaves the same on Windows and Linux.
# Without this, Windows checks out LF files as CRLF and every commit shows
# "LF will be replaced by CRLF" warnings.

* text=auto eol=lf

# Anything that must stay CRLF on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles and generated files are not worth diffing.
package-lock.json -diff
*.tsbuildinfo binary